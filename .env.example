# Urban Cycling path configuration
# Copy this file to .env and adjust only if your data folders are elsewhere.
# For deployment, prefer paths outside this repository.

# Medallion layer roots (relative paths resolve from project root)
BRONZE_PATH=02_data/bronze
SILVER_PATH=02_data/silver
GOLD_PATH=02_data/gold

# Gold subdirectories
FACTS_PATH=02_data/gold/facts
DIMENSIONS_PATH=02_data/gold/dimensions
NOTEBOOK_EXPORTS_PATH=02_data/gold/notebook_exports

# Scraper output paths (new names)
BRONZE_OSLO_PATH=02_data/bronze/oslo
BRONZE_BERGEN_PATH=02_data/bronze/bergen
BRONZE_TRONDHEIM_PATH=02_data/bronze/trondheim

# Backward-compatible scraper names (optional)
OSLO=02_data/bronze/oslo
BERGEN=02_data/bronze/bergen
TRONDHEIM=02_data/bronze/trondheim

# Streamlit Community Cloud foundation:
# If data files are not present in the deployed container, configure a public
# base URL hosting your gold layer files in this layout:
#   <base>/dimensions/dim_city.csv
#   <base>/dimensions/dim_stations.csv
#   <base>/dimensions/dim_date.csv
#   <base>/facts/fact_trips_<year>.csv
#   <base>/facts/fact_top_trip_patterns.csv
GOLD_PUBLIC_BASE_URL=

# Comma-separated list used by app when local fact_trips files are unavailable.
# Example: 2024,2025
AVAILABLE_YEARS=

# Optional for GitHub Actions CI remote endpoint validation.
# Mirror these values into .github/community-cloud-config.json if you want
# ci-community.yml to verify remote gold files before deployment updates.
